<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AssemblyName>Shirubasoft.Aspire.Hosting.TigerBeetle</AssemblyName>
    <RootNamespace>Aspire.Hosting.TigerBeetle</RootNamespace>
    <PackageId>Shirubasoft.Aspire.Hosting.TigerBeetle</PackageId>
    <Title>Aspire hosting integration for TigerBeetle</Title>
    <Description>Runs TigerBeetle and its RabbitMQ change data capture job as Aspire container resources with polyglot APIs, persistence, health checks, and deployment manifest support.</Description>
    <Authors>Shirubasoft</Authors>
    <PackageTags>aspire;tigerbeetle;database;distributed-systems;container;cdc;rabbitmq</PackageTags>
    <PackageReadmeFile>README.md</PackageReadmeFile>
    <RepositoryType>git</RepositoryType>
    <RepositoryUrl>https://github.com/shirubasoft/aspire-tigerbeetle</RepositoryUrl>
    <PackageProjectUrl>https://github.com/shirubasoft/aspire-tigerbeetle</PackageProjectUrl>
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <EnablePackageValidation>true</EnablePackageValidation>
    <EnableAspireIntegrationAnalyzers>true</EnableAspireIntegrationAnalyzers>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Hosting" />
    <PackageReference Include="Aspire.Hosting.RabbitMQ" />
    <PackageReference Include="Microsoft.SourceLink.GitHub" PrivateAssets="all" />
  </ItemGroup>

  <ItemGroup>
    <None Include="../../README.md" Pack="true" PackagePath="/" />
  </ItemGroup>
</Project>
